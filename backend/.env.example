# ===== LLM 配置 (DeepSeek, OpenAI 兼容) =====
# 由 LangChain ChatOpenAI 读取(阶段3起)
LLM_MODEL_ID=deepseek-flash
LLM_API_KEY=your_key
LLM_BASE_URL=https://api.deepseek.com

# ===== 高德地图 (Web服务 key, 同时用于高德 MCP server) =====
AMAP_MAPS_API_KEY=your_key

# ===== Unsplash =====
UNSPLASH_ACCESS_KEY=your_key

# ===== CORS 白名单(阶段9) =====
# 逗号分隔的允许来源; 部署时改成实际域名, 如 http://trip.example.com
CORS_ORIGINS=http://localhost:5173
